{
    "name": "vatenia/r2-storage",
    "description": "Cloudflare R2 (S3 API) file storage for PHP and Symfony, without the AWS SDK: signed uploads, deletes, presigned links, and the same interface for local disk in development.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{ "name": "Vatenia" }],
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-simplexml": "*",
        "symfony/http-client-contracts": "^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "vimeo/psalm": "^6.19"
    },
    "suggest": {
        "symfony/http-client": "The HTTP client the R2 client sends its requests with"
    },
    "autoload": {
        "psr-4": { "Vatenia\\R2Storage\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Vatenia\\R2Storage\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "psalm": "psalm --no-progress",
        "qa": ["@cs", "@phpstan", "@psalm", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
